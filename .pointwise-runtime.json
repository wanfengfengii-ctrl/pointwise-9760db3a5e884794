{
  "version": 1,
  "kind": "web",
  "setup": [["python3", "-B", "-m", "gallery.web.server", "--database", "gallery.sqlite3", "seed"]],
  "start": ["sh", "-c", "test \"$1\" = 127.0.0.1 && exec python3 -B -m gallery.web.server --database gallery.sqlite3 serve --port \"$2\"", "gallery", "${POINTWISE_HOST}", "${POINTWISE_PORT}"],
